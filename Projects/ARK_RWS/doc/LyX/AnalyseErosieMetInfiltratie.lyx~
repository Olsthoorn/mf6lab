Bij een redelijke waarde van 
\begin_inset Formula $\Delta H=z=\unit[1]{m}$
\end_inset

volgt
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\tau_{c}}{\tau_{c,0}} & =1+\frac{1000}{2650-1000}\times1\\
 & =1+0.61
\end{align*}

\end_inset


\end_layout

