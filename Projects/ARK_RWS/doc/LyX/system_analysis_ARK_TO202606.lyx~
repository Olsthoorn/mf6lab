\begin_layout Standard
We hebben de volgende relatie,
 die zegt dat het vaste hoogste peil,
 
\begin_inset Formula $h_{A}$
\end_inset

,
 (in het kanaal) minus het vaste laagste peil,
 
\begin_inset Formula $h_{p}$
\end_inset

,
 (polder) gelijk is aan de infiltratieflux 
\begin_inset Formula $q$
\end_inset

 [m/d] maal de som van de weerstand tussen kanaal en referentiepunt,
 
\begin_inset Formula $c_{A}$
\end_inset

 [d],en de weerstand tussen referentiepunt en polderpeil,
 
\begin_inset Formula $c_{B}$
\end_inset

 [d].
 Alleen de infiltratieflux en de weerstand tussen kanaal en referentiepunt hangen van de temperatuur en dus van de viscositeit af:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h_{A}-h_{p}=q\left(T\right)\left(c_{A}\left(T\right)+c_{B}\right)\label{eq:hA-hp}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Deze relatie geldt ook voor een op zich willekeurige concrete referentietemperatuur 
\begin_inset Formula $T_{r}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h_{A}-h_{p}=q\left(T_{r}\right)\left(c_{A}\left(T_{r}\right)+c_{B}\right)\label{eq:hA-hp-woth-Tr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
zodat
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
q_{T}\left(c_{A,T}+c_{B}\right)=q_{T_{r}}\left(c_{A,T_{r}}+c_{B}\right)\label{eq:qT-qTr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{q_{T}}{q_{T_{r}}}=q_{T_{r}}\left(\frac{c_{A,T_{r}}+c_{B}}{c_{A,T}+c_{B}}\right)\label{eq:qT}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
De weerstand 
\begin_inset Formula $c_{A,T}$
\end_inset

 kan via de viscositeit,
 
\begin_inset Formula $\mu$
\end_inset

,
 worden omgerekend naar de referentie weerstand
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
c_{A,T}=c_{A}\frac{\mu_{T}}{\mu_{T_{r}}}\label{eq:cT}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Ingevuld in 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:qT"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 en het rechterlid boven en onder delen door de referentieweerstand 
\begin_inset Formula $c_{A,T_{r}}$
\end_inset

 levert
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{q_{T}}{q_{T_{r}}}=\frac{1+c_{B}/c_{A,T_{r}}}{\frac{\mu_{T}}{\mu_{T_{r}}}+c_{B}/c_{A,T_{r}}}\label{eq:qT/qTr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
De verhouding tussen de constante 
\begin_inset Formula $c_{B}$
\end_inset

 en de weerstand bij referentietemperatuur 
\begin_inset Formula $c_{A,T_{r}}$
\end_inset

 is bekend.
 Deze is namelijk gelijk aan
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{c_{B}}{c_{A,T_{r}}}=\frac{h_{r,T_{r}}-h_{p}}{h_{a}-h_{r,T_{r}}}\label{eq:cB/cAr}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
waarin 
\begin_inset Formula $h_{r,T_{r}}$
\end_inset

 de stijghoogte op het referentiepunt is bij de referentietemperatuur.
\end_layout

\begin_layout Standard
De stijghoogte in het referentiepunt bij willekeurige temperatuur ,
\begin_inset Formula $h_{R}$
\end_inset

,
 is gelijk aan polderpeil maal 
\begin_inset Formula $q_{T}c_{B}$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
h_{R} & =h_{p}+q_{T}c_{B}\label{eq:hR}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Dit kan direct worden omgeschreven naar
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h_{R}=h_{p}+\frac{q_{T}}{q_{T_{r}}}\left(q_{T_{r}}c_{B}\right)\label{eq:hR1}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
waarin 
\begin_inset Formula $q_{T_{r}}c_{B}=h_{R,T_{r}}-h_{p}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h_{R}=h_{p}+\frac{q_{T}}{q_{T_{r}}}\left(h_{R,T_{r}}-h_{p}\right)\label{eq:hR2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We kunnen 
\begin_inset Formula $q_{T}/q_{T_{r}}$
\end_inset

 in (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:qT/qTr"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) direct uitdrukken in de stijghoogte want,
 
\begin_inset Formula $c_{A,T_{r}}/c_{B}$
\end_inset

 is bekend uit de referentiesituatie
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{q_{T}}{q_{T_{r}}}=\frac{1+\frac{h_{r,T_{r}}-h_{p}}{h_{a}-h_{r,T_{r}}}}{\frac{\mu_{T}}{\mu_{T_{r}}}+\frac{h_{r,T_{r}}-h_{p}}{h_{a}-h_{r,T_{r}}}}\label{eq:qR/qTr-2}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
zodat
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{q_{T}}{q_{T_{r}}}=\frac{h_{a}-h_{p}}{\left(h_{a}-h_{r,T_{r}}\right)\frac{\mu_{T}}{\mu_{T_{r}}}+\left(h_{r,T_{r}}-h_{p}\right)}\label{eq:qT/qTr-3}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Ingevuld in (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:hR2"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) geeft dit een gesloten vergelijking om 
\begin_inset Formula $h_{R}$
\end_inset

 op het referentiepunt bij willekeurige temperatuur te kunnen berekenen
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
h_{R}=h_{p}+\frac{h_{a}-h_{p}}{\left(\frac{h_{a}-h_{r,T_{r}}}{h_{R,T_{r}}-h_{p}}\right)\frac{\mu_{T}}{\mu_{T_{r}}}+1}
\]

\end_inset


\end_layout

\begin_layout Standard
Tabel 
\begin_inset CommandInset ref
LatexCommand ref
reference "tab:Peilbuizen-effect_viscositeit"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 geeft de resultaten van de berekening.
 Het eerste cijfer (of eerste 2 cijfers) van de peilbuisnaam is het raainummer.
 De gemeten winterdal-stijghoogte,
 
\begin_inset Formula $h_{w,gem}$
\end_inset

,
 wordt als referentie genomen.
 Dus de stijghoogte neemt af van 
\begin_inset Formula $h_{ARK}$
\end_inset

 over de gemeten winterstijghoogte 
\begin_inset Formula $h_{w,gem}$
\end_inset

 naar het polderpeil 
\begin_inset Formula $h_{pold}$
\end_inset

.
 De gebuikte zomertemperatuur 
\begin_inset Formula $T_{z}$
\end_inset

 en wintertemperatuur 
\begin_inset Formula $T_{w}$
\end_inset

,
 de daaruit volgende verhouding tussen de zomer- en winterviscositeit 
\begin_inset Formula $\mu_{T_{z}}/\mu_{T_{w}}$
\end_inset

en de met (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:qT/qTr-3"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) berekende verhouding tussen de infiltratiesnelheid in de zomer en in de winter 
\begin_inset Formula $q_{z}/q_{w}$
\end_inset

.
 Vervolgens wordt de berekende zomerstijghoogte 
\begin_inset Formula $h_{z,ber}$
\end_inset

 op het referentiepunt vergeleken met de gemeten zomerstijghoogte 
\begin_inset Formula $h_{z,gem}$
\end_inset

 (die was afgeleid uit de tijdstijghoogtelijn van de peilbuis).
 De laatste kolom geeft het verschil tussen de gemeten zomerstijghoogte en de berekende.
 Deze waarden zijn positief wanneer de gemeten stijghoogte hoger is dan de berekende.
 De resultaten zijn ook weergegeven in Fig.
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:Gemeten-zomerstijghoogten-versus-berekende"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

