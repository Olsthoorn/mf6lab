\begin_layout Standard
\begin_inset Formula 
\begin{equation}
h_{A}-h_{p}=q\left(T\right)\left(c_{A}\left(T\right)+c_{B}\right)\label{eq:hA-hp}
\end{equation}

\end_inset


\end_layout

