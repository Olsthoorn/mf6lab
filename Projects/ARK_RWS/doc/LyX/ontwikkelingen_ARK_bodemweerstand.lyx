 door ronddraaiende water is een klassiek vloeistofmechanica probleem 
\end_layout

\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\Delta p & =\frac{1}{2}\rho\omega^{2}R^{2}=\frac{1}{2}\rho v^{2}\\
\Delta\phi & =\frac{v^{2}}{2g}=\frac{2.5^{2}}{2\times9.81}=0.32\,m
\end{align*}

\end_inset


