\begin_layout Section
Erosie
\end_layout

\begin_layout Standard
De meest gebruikte formule voor erosie van een zandbed door waterstroming is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
U_{s}=\sqrt{\frac{\theta_{c}}{C_{F}}\frac{\rho_{s}-\rho_{w}}{\rho_{w}}gd}
\]

\end_inset


\end_layout

\begin_layout Description
\begin_inset Formula $\theta_{c}$
\end_inset

 kritische Shields parameter [-]
\end_layout

\begin_layout Description
\begin_inset Formula $d$
\end_inset

 korreldiameter
\end_layout

\begin_layout Description
\begin_inset Formula $C_{f}$
\end_inset

 
\begin_inset Formula $\tau=/\left(\rho U^{2}\right)$
\end_inset


\end_layout

\begin_layout Description
\begin_inset Formula $\tau_{c}$
\end_inset

 
\begin_inset Formula $=\theta_{c}\left(\rho_{c}-\rho_{w}\right)gd$
\end_inset


\end_layout

\begin_layout Description
\begin_inset Formula $U$
\end_inset

 watersnelheid [m/s]
\end_layout

