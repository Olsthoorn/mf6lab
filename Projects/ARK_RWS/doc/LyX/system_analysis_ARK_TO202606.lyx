\begin_layout Standard
We kunnen het altijd gelijke stijghoogteverschil tussen het ARK en de polder 
\begin_inset Formula $\Delta\phi_{0}$
\end_inset

 in de zomer opdelen in het stuk 
\begin_inset Formula $\Delta\phi_{za}$
\end_inset

 tussen ARK en Boxtel en en 
\begin_inset Formula $\Delta\phi_{zb}$
\end_inset

 tussen Boxtel en het polder peil met infiltratiesnelheid 
\begin_inset Formula $q_{z}$
\end_inset

 en in de winter met infiltratiesnelheid 
\begin_inset Formula $q_{w}$
\end_inset

 in resp.
 
\begin_inset Formula $\Delta\phi_{wa}$
\end_inset

 en 
\begin_inset Formula $\Delta\phi_{wb}$
\end_inset

.
 Na deling door 
\begin_inset Formula $q_{z}$
\end_inset

 resp.
 
\begin_inset Formula $q_{w}$
\end_inset

 krijgen we weerstanden:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\Delta\phi_{0}}{q_{z}} & =\frac{\Delta\phi_{za}}{q_{z}}+\frac{\Delta\phi_{zb}}{q_{z}}\\
\frac{\Delta\phi_{0}}{q_{w}} & =\frac{\Delta\phi_{wa}}{q_{w}}+\frac{\Delta\phi_{wb}}{q_{w}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Door het temperatuurverschil veranderen de totale weerstand en die over het traject ARK-Boxtel,
 maar die over het traject Boxtel-polder blijft ongewijzigd,
 zodat 
\begin_inset Formula 
\[
\frac{\Delta\phi_{zb}}{q_{z}}=\frac{\Delta\phi_{wb}}{q_{w}}
\]

\end_inset


\end_layout

\begin_layout Standard
Dit geeft
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\Delta\phi_{0}}{q_{z}} & -\frac{\Delta\phi_{za}}{q_{z}}=\frac{\Delta\phi_{0}}{q_{w}}-\frac{\Delta\phi_{wa}}{q_{w}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
en na herschikking
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Delta\phi_{wa}=\frac{q_{w}}{q_{z}}\Delta\phi_{za}+\Delta\phi_{0}\left(1-\frac{q_{w}}{q_{z}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\Delta\phi_{wa}}{\Delta\phi_{0}}=\frac{q_{w}}{q_{z}}\frac{\Delta\phi_{za}}{\Delta\phi_{0}}+\left(1-\frac{q_{w}}{q_{z}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Delta\phi_{za} & =\frac{q_{z}}{q_{w}}\Delta\phi_{wa}+\Delta\phi_{0}\left(1-\frac{q_{z}}{q_{w}}\right)
\end{align*}

\end_inset

+
