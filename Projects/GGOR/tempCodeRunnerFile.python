# %% [markdown] Einstein puzzles
#
# Einstein puzzels zijn logische puzzels waarin je op basis
# van in zinnen verpakte gegevens unieke combinaties
# moet bepalen van een aantal categoriëen.

# %%
wie = ['A', 'B', 'C']
dier = ['K', 'H', 'V']
kleur = ['B', 'G', 'R']

# %%
for w in wie:
    #print(w, end="")
    for d in dier:
        #print(d, end="")
        for k in kleur:
            #print(k)
            if not ((w == 'A') and (not (d == 'H'))):
                break
            if not ((d == 'K') and (k == 'G')):
                break
            if not((w == 'B') and (not (k == 'B'))):
                break
            if not ((w == 'C') and (d == 'V')):
                break
            print(w, d, k)